<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_channel_row"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="8dp" android:paddingEnd="8dp"
    android:background="?android:attr/selectableItemBackground">
    <ImageView android:id="@+id/widget_channel_logo"
        android:layout_width="32dp" android:layout_height="32dp"
        android:scaleType="fitCenter" android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_channel" />
    <TextView android:id="@+id/widget_channel_name"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="12dp" android:gravity="center_vertical"
        android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="#FFFFFF" />
</LinearLayout>
